# ============================================================
# PostgreSQL Production Stack — Configuration Template
#
# 1. Copy to .env:   cp .env.example .env
# 2. Fill every CHANGE_ME_* value.
# 3. Run:            bash scripts/install.sh --local
#
# Everything else is set automatically by install/reinstall scripts.
# NEVER commit .env to version control.
# ============================================================

# ============================================================
# PostgreSQL Superuser
# This user becomes the Postgres superuser and PgBouncer admin.
# ============================================================
POSTGRES_USER=CHANGE_ME_USERNAME
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# System database used for admin connections and backup introspection.
# Keep as "postgres" unless you have a specific reason to change.
POSTGRES_DB=postgres
POSTGRES_MAINTENANCE_DB=postgres

# ============================================================
# Network — Server public IP for PgBouncer external binding.
# Clients connect to this IP on port 6432.
# Use 0.0.0.0 only if protected by an external firewall.
# ============================================================
SERVER_PUBLIC_IP=CHANGE_ME_SERVER_IP

# ============================================================
# PgBouncer
# ============================================================
PGBOUNCER_LISTEN_PORT=6432

# ============================================================
# Backup
# ============================================================
BACKUP_DEST_PATH=/backups
BACKUP_RETENTION_DAYS=7

# ============================================================
# Monitoring
# ============================================================
POSTGRES_EXPORTER_PORT=9187

# ============================================================
# Internal Docker network name (usually no need to change)
# ============================================================
NETWORK_NAME=pg_private_net

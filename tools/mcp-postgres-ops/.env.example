# ============================================================
# MCP Server — Configuration Template
#
# 1. Copy to .env:  cp .env.example .env
# 2. Fill every CHANGE_ME_* value (same creds as docker/.env)
# 3. server-update.sh auto-populates STACK_DIR and PG_PORT
#    on first run — no manual edit needed for those.
# ============================================================

# ============================================================
# PostgreSQL connection (via PgBouncer on host port 6432)
# Must match values in docker/.env
# ============================================================
PG_HOST=127.0.0.1
PG_PORT=6432
PG_USER=CHANGE_ME_USERNAME
PG_PASSWORD=CHANGE_ME_STRONG_PASSWORD
PG_MAINTENANCE_DB=postgres

# ============================================================
# PgBouncer admin interface (same host/port)
# ============================================================
PGBOUNCER_HOST=127.0.0.1
PGBOUNCER_PORT=6432

# ============================================================
# Path to the docker/ directory on the server
# Auto-filled by scripts/server-update.sh — do not change manually
# unless you moved the repository.
# ============================================================
STACK_DIR=/opt/postgressops/docker
SCRIPTS_DIR=/opt/postgressops/scripts

# ============================================================
# MCP log file (optional)
# ============================================================
MCP_LOG_FILE=/tmp/mcp-postgres-ops.log

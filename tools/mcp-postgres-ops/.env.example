# ============================================================
# MCP Postgres Ops — Configuration
# Copy to .env and fill in real values.
# ============================================================

# PostgreSQL superuser connection (host-level, defaults to PgBouncer port)
PG_HOST=127.0.0.1
PG_PORT=6432
PG_USER=Makmiller
PG_PASSWORD=Rty45678+
PG_MAINTENANCE_DB=postgres

# PgBouncer
PGBOUNCER_HOST=127.0.0.1
PGBOUNCER_PORT=6432

# Stack paths (on the server — used by shell-exec tools)
STACK_DIR=/root/apps/postgres-prisma-stack/postgressserver-prisma-postgres-stack-v2/docker

# Log file path
MCP_LOG_FILE=/var/log/mcp-postgres-ops.log
